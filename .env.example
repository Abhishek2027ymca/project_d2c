# --- Database ---
# Option A (recommended): a single connection string from a hosted Postgres.
# Neon gives you this on the project dashboard. Keep ?sslmode=require.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Option B: discrete vars, for a local/Docker Postgres.
# Only used when DATABASE_URL is unset.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=support_ops_agent

# --- Redis (needed from Week 2 onward, for the BullMQ queue) ---
REDIS_URL=

# --- API ---
API_PORT=3000
NODE_ENV=development

# --- Claude ---
ANTHROPIC_API_KEY=
