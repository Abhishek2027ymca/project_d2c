{
  "name": "support-ops-agent",
  "version": "1.0.0",
  "description": "AI Support-Ops Agent with approval gates and audit trails",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "verify:tools": "tsx src/scripts/verifyTools.ts",
    "verify:queue": "tsx src/scripts/verifyQueue.ts",
    "queue:clear": "tsx src/scripts/clearQueue.ts"
  },
  "keywords": [],
  "author": "Abhishek Singh",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.18.0",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
